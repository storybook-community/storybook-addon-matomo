{
  "name": "@storybook-community/storybook-addon-matomo",
  "version": "0.0.0-semantically-released",
  "description": "Storybook addon for Matomo Analytics",
  "keywords": [
    "storybook-addon",
    "storybook-community",
    "storybook",
    "analytics",
    "matomo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storybook-community/storybook-addon-matomo.git"
  },
  "type": "module",
  "author": "Alex Nicholls (https://github.com/anicholls)",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manager": "./dist/manager.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "manager.js",
    "preview.js"
  ],
  "bundler": {
    "previewEntries": [
      "src/index.ts"
    ],
    "managerEntries": [
      "src/manager.ts"
    ]
  },
  "scripts": {
    "build": "tsup",
    "build:storybook": "storybook build",
    "build:watch": "pnpm build --watch",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint --cache .",
    "lint:fix": "pnpm lint --fix",
    "pack": "pnpm pack --out storybook-addon-matomo-$(date +%s).tgz",
    "prebuild": "node -e \"fs.rmSync('./dist', { recursive: true, force: true })\"",
    "prepare": "husky",
    "prerelease": "zx scripts/prepublish-checks.js",
    "release": "pnpm build && pnpm semantic-release",
    "release:canary": "pnpm build && auto canary",
    "start": "run-p build:watch \"storybook --quiet\"",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-docs": "^11.0.0-beta.3",
    "@storybook/addon-vitest": "^11.0.0-beta.3",
    "@storybook/react-vite": "^11.0.0-beta.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-istanbul": "^5.1.0",
    "auto": "^11.3.6",
    "boxen": "^9.0.0",
    "commitlint": "^21.2.4",
    "dedent": "^1.7.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^11.0.0-beta.3",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "npm-run-all2": "^9.0.4",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "prompts": "^2.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semantic-release": "^25.0.9",
    "storybook": "^11.0.0-beta.3",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zx": "^8.8.5"
  },
  "peerDependencies": {
    "storybook": "^11.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "storybook": {
    "displayName": "Matomo (community version)",
    "supportedFrameworks": [
      "supported-frameworks"
    ],
    "icon": "https://raw.githubusercontent.com/storybook-community/storybook-addon-matomo/main/static/icon.png"
  }
}
